DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: sync slash commands to one guild instantly while developing
GUILD_ID=
# 32-byte key as 64 hex chars (openssl rand -hex 32)
ENCRYPTION_KEY=
# Poll interval in milliseconds (default 180000 = 3 min)
POLL_INTERVAL_MS=180000
# SQLite path (default ./data/hevybot.db)
DATABASE_PATH=./data/hevybot.db
